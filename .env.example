NODE_ENV=development
PORT=5000
MONGO_URI=
JWT_SECRET=
ADMIN_JWT_SECRET=
CUSTOMER_JWT_SECRET=
BANK_ENC_KEY=
CLIENT_URL=http://localhost:5173
CLIENT_URLS=http://localhost:5173
API_PUBLIC_URL=http://localhost:5000

SMTP_USER=
SMTP_PASS=

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Optional: RazorpayX payouts. Falls back to the RAZORPAY_* keys above; the
# account number is only needed to create payouts, not to verify one.
RAZORPAYX_KEY_ID=
RAZORPAYX_KEY_SECRET=
RAZORPAYX_ACCOUNT_NUMBER=

# Required. Every KYC document, settlement bill and agreement PDF is stored
# in Cloudinary (as a private file) — nothing is kept on the server's disk.
# Uploads and agreement generation fail until these are set.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=spotx-partner-platform

INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
META_APP_ID=
META_APP_SECRET=
META_LOGIN_CONFIG_ID=
META_GRAPH_VERSION=v21.0
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
